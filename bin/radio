#!/bin/sh

set -eu

usage() {
  printf '%s\n' 'Usage: radio {sleep|liquid|giants}' >&2
}

if [ "$#" -ne 1 ]; then
  usage
  exit 2
fi

mode=$1
case "$mode" in
  sleep|liquid|giants) ;;
  *)
    usage
    exit 2
    ;;
esac

command -v ffplay >/dev/null 2>&1 || {
  printf '%s\n' 'radio: ffplay is missing (install FFmpeg with your package manager)' >&2
  exit 1
}

banner() {
  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    printf '\033[38;5;%sm' "$1"
    cat
    printf '\033[0m'
  else
    cat
  fi
}

np_pid=''
viz_pid=''
player_pid=''
viz_dir=''
viz_color=0

np_stop() {
  # Capturing $? stops the trap from laundering the exit status: mksh would
  # otherwise report the EXIT trap's own status (0) after Ctrl-C.
  st=$?
  if [ -n "$np_pid" ]; then
    kill "$np_pid" 2>/dev/null || true
  fi
  if [ -n "$viz_pid" ]; then
    kill "$viz_pid" 2>/dev/null || true
    # The renderer hides the cursor and may die before restoring it.
    printf '\033[?25h'
  fi
  if [ -n "$viz_dir" ]; then
    rm -rf "$viz_dir"
  fi
  return "$st"
}

# The EXIT trap is armed before the visualizer's tmpdir exists so no early
# failure (a bad cookie, say) can leak it.
trap np_stop EXIT

# RADIO_VIZ=1 turns the station art into a live VU meter: rows light up from
# the bottom in the station color as the stream gets louder. It needs ffmpeg
# (not just ffplay) and a terminal; missing ffmpeg warns once and plays
# exactly as before, and a non-terminal stdout skips the meter silently, the
# way banner skips color. RADIO_VIZ=force waives the terminal check so the
# tests can capture frames from a file.
if [ -n "${RADIO_VIZ:-}" ]; then
  if ! command -v ffmpeg >/dev/null 2>&1; then
    printf '%s\n' 'radio: RADIO_VIZ needs ffmpeg; playing without the visualizer' >&2
  elif [ -t 1 ] || [ "$RADIO_VIZ" = force ]; then
    viz_dir=$(mktemp -d)
    mkfifo "$viz_dir/meta"
    : >"$viz_dir/np"
    if [ -z "${NO_COLOR:-}" ]; then
      viz_color=1
    fi
  fi
fi

# In visualizer mode the banner is not printed here: the art goes to a file so
# the renderer can redraw it on every loudness reading.
show_art() {
  if [ -n "$viz_dir" ]; then
    cat >"$viz_dir/art"
  else
    banner "$color"
  fi
}

# Now-playing metadata source for the selected station; empty np_url means the
# station has none (KNBR is talk programming, not tracks).
np_url=''
np_kind=''
np_cookie=''

case "$mode" in
  sleep)
    nitejar_cookie=${NITEJAR_COOKIE:-}
    unset NITEJAR_COOKIE
    case "$nitejar_cookie" in
      ''|*[!0123456789abcdef]*)
        printf '%s\n' 'radio: NITEJAR_COOKIE must be a 64-character lowercase SHA-256 value' >&2
        exit 1
        ;;
    esac
    if [ "${#nitejar_cookie}" -ne 64 ]; then
      printf '%s\n' 'radio: NITEJAR_COOKIE must be a 64-character lowercase SHA-256 value' >&2
      exit 1
    fi

    color=110
    show_art <<'ART'
                   .       *
       *       .                    .
                   _..._
                .:::::::.
               :::::::::::
               :::::::'
               `:::::'
                  `'

 _   _ ___ _____ _____      _    _    ____
| \ | |_ _|_   _| ____|    | |  / \  |  _ \
|  \| || |  | | |  _|   _  | | / _ \ | |_) |
| |\  || |  | | | |___ | |_| |/ ___ \|  _ <
|_| \_|___| |_| |_____| \___//_/   \_\_| \_\
                 [ A M B I E N T ]

ART
    station='Nitejar'
    # ffplay wants the header CRLF-terminated: $(printf '\r') keeps the CR and the
    # quoted line break supplies the LF. The cookie is validated above so it
    # cannot inject another header.
    header="Cookie: nj_awake=$nitejar_cookie$(printf '\r')
"
    set -- -headers "$header" -i 'https://nitejar.net/stream/nightjar.opus'
    # The title lives on the MP3 mount in status-json (the Opus mount carries
    # none), exactly as the Nitejar web player reads it. Same gate cookie.
    np_url='https://nitejar.net/stream/status-json.xsl'
    np_kind='icecast'
    np_cookie="nj_awake=$nitejar_cookie"
    ;;

  liquid)
    color=45
    show_art <<'ART'
                    .
                   / \
                  /   \
                 /     \
                /       \
               |         |
                \       /
                 '.___.'
             _.-'     '-._
       _..--'             '--.._
 ~~~~~~      ~~~~   ~~~~       ~~~~~~

 _     ___  ___  _   _ ___ ____
| |   |_ _|/ _ \| | | |_ _|  _ \
| |    | || | | | | | || || | | |
| |___ | || |_| | |_| || || |_| |
|_____|___|\__\_\\___/|___|____/
          [ J A Z Z Y  D R U M  &  B A S S ]

ART
    station='Liquid DnB'
    set -- -i 'https://antares.dribbcast.com/proxy/dave1/stream/;'
    # Shoutcast v2 serves the current song as one line of plain text.
    np_url='https://antares.dribbcast.com/proxy/dave1/currentsong?sid=1'
    np_kind='text'
    ;;

  giants)
    color=208
    show_art <<'ART'
                 .-""""""""-.
              .-'            '-.
            .'   /`-.      .-'\   '.
           /    /-/          \-\    \
          ;    /-/            \-\    ;
          |   /-/              \-\   |
          |  ( (       SF       ) )  |
          |   \-\              /-/   |
          ;    \-\            /-/    ;
           \    \-\          /-/    /
            '.   \`-.      .-'/   .'
              '-.            .-'
                 '-.______.-'

  ____ ___    _    _   _ _____ ____
 / ___|_ _|  / \  | \ | |_   _/ ___|
| |  _ | |  / _ \ |  \| | | | \___ \
| |_| || | / ___ \| |\  | | |  ___) |
 \____|___/_/   \_\_| \_| |_| |____/
             [ S A N  F R A N C I S C O ]

ART
    station='KNBR 104.5 FM / 680 AM'
    set -- -i 'https://playerservices.streamtheworld.com/api/livestream-redirect/KNBRAMAAC.aac'
    ;;

esac

# Now playing: a background poller fetches the station's status endpoint and
# prints the track title when it changes. Status endpoints, never a second
# audio connection — a poll costs bytes, not a listener slot. curl is a soft
# dependency: without it the station plays exactly as before, just untitled.

np_fetch() {
  # curl -m bounds time, not bytes; dd caps a hostile endpoint at 8 KiB per
  # poll so neither the shell variable holding the title nor sed's line buffer
  # can be grown without bound.
  if [ -n "$np_cookie" ]; then
    curl -fs -m 10 -H "Cookie: $np_cookie" "$np_url"
  else
    curl -fs -m 10 "$np_url"
  fi | dd bs=1 count=8192 2>/dev/null
}

np_title() {
  # The tr is an ASCII whitelist, not a control-byte blocklist: C0 controls,
  # DEL, UTF-8-encoded C1 controls (8-bit CSI/OSC), and bidi overrides must
  # all die before a station-controlled title reaches the terminal, and a
  # blocklist misses the multi-byte forms. LC_ALL=C keeps sed and tr
  # byte-oriented (BSD builds abort on bytes invalid in a UTF-8 locale);
  # cut bounds the printed line and is safe here because the whitelist has
  # already reduced the stream to single-byte characters.
  case "$np_kind" in
    icecast)
      np_fetch | LC_ALL=C sed -n 's/.*"listenurl":"[^"]*nightjar\.mp3"[^}]*"title":"\([^"]*\)".*/\1/p'
      ;;
    *)
      np_fetch
      ;;
  esac | LC_ALL=C tr -cd ' -~' | cut -c 1-200
}

np_poll() {
  np_last=''
  while :; do
    np_now=$(np_title 2>/dev/null || true)
    kill -0 "$$" 2>/dev/null || exit 0
    if [ -n "$np_now" ] && [ "$np_now" != "$np_last" ]; then
      np_last=$np_now
      if [ -n "$viz_dir" ]; then
        # The renderer owns the terminal in visualizer mode; printing here
        # would race its cursor movements. The title (already reduced to
        # printable ASCII by np_title) is parked in a file the renderer reads
        # on every frame instead.
        printf '%s\n' "$np_now" >"$viz_dir/np"
      else
        printf 'Now playing: %s\n' "$np_now"
      fi
    fi
    # Sleep in 1-second slices: kill -9 of the script skips every trap, and
    # this bounds how long an orphaned poller can outlive its parent.
    np_t=0
    while [ "$np_t" -lt 15 ]; do
      sleep 1
      kill -0 "$$" 2>/dev/null || exit 0
      np_t=$((np_t + 1))
    done
  done
}

if [ -n "$viz_dir" ]; then
  # ffplay's keyboard handling is lost once its stdin is the PCM pipe.
  printf '%s\n' "Playing $station — press Ctrl-C to stop."
else
  printf '%s\n' "Playing $station — press q or Ctrl-C to stop."
fi

# ffplay used to be exec'd. It now runs as a background child under wait, for
# two reasons: the EXIT trap must reap the poller, and a trapped signal is
# deferred for as long as the shell waits on a FOREGROUND child — kill on the
# script's PID would neither stop playback nor run any trap. POSIX guarantees
# that wait returns the moment a trapped signal arrives, so INT/TERM forward
# to ffplay immediately and its exit status becomes this script's, as it was
# under exec. (Backgrounding does not detach ffplay from the terminal's
# process group, so plain Ctrl-C still reaches it directly as well.)

forward() {
  if [ -n "$player_pid" ]; then
    kill -s "$1" "$player_pid" 2>/dev/null || true
  else
    exit "$2"
  fi
}

trap 'forward INT 130' INT
trap 'forward TERM 143' TERM

if [ -n "$viz_dir" ]; then
  # One connection, one decode: ffmpeg pulls the stream, hands raw PCM to
  # ffplay over a pipe, and an astats/ametadata filter in the same process
  # reports one RMS loudness reading per 4800 samples (about ten a second).
  # ametadata prints on ffmpeg's stderr, which is routed into a FIFO the awk
  # renderer below reads — no second listener slot, no audio on disk. ffmpeg's
  # other log lines share that stderr; the renderer ignores every line that is
  # not an RMS reading.
  #
  # The renderer repaints the whole banner on each reading: rows above the
  # level stay a dim ghost, rows below light up in the station color (with
  # NO_COLOR, lit rows are drawn and unlit rows left blank). Loudness maps
  # -50..-5 dB RMS onto the art's height, rising instantly and falling with a
  # short decay so the meter breathes instead of flickering. It exits on its
  # own when the FIFO's write side closes with ffmpeg.
  LC_ALL=C awk \
    -v artfile="$viz_dir/art" \
    -v npfile="$viz_dir/np" \
    -v color="$color" \
    -v use_color="$viz_color" '
    function draw(lv,    filled, i, np) {
      filled = int(lv * nrows + 0.5)
      if (drawn) printf "\033[%dA", nrows + 1
      drawn = 1
      for (i = 1; i <= nrows; i++) {
        if (i > nrows - filled) {
          if (use_color) printf "\033[2K\033[1;38;5;%dm%s\033[0m\n", color, art[i]
          else printf "\033[2K%s\n", art[i]
        } else if (use_color) {
          printf "\033[2K\033[38;5;238m%s\033[0m\n", art[i]
        } else {
          printf "\033[2K\n"
        }
      }
      np = ""
      getline np < npfile
      close(npfile)
      if (np != "") printf "\033[2KNow playing: %s\n", np
      else printf "\033[2K\n"
      fflush()
    }
    BEGIN {
      while ((getline line < artfile) > 0) art[++nrows] = line
      close(artfile)
      level = 0
      printf "\033[?25l"
      draw(0)
    }
    /lavfi\.astats\.Overall\.RMS_level=/ {
      v = $0
      sub(/.*=/, "", v)
      if (v == "" || v ~ /inf|nan/) db = -50
      else {
        db = v + 0
        if (db < -50) db = -50
        if (db > -5) db = -5
      }
      target = (db + 50) / 45
      if (target > level) level = target
      else level = 0.6 * level + 0.4 * target
      draw(level)
    }
  ' "$viz_dir/meta" &
  viz_pid=$!

  # -nostdin keeps backgrounded ffmpeg's hands off the terminal. The station
  # input arguments in "$@" sit after the reconnect options (input options
  # must precede their -i) exactly as they would for ffplay.
  ffmpeg \
    -hide_banner \
    -nostats \
    -nostdin \
    -reconnect 1 \
    -reconnect_at_eof 1 \
    -reconnect_on_network_error 1 \
    -reconnect_streamed 1 \
    -reconnect_delay_max 5 \
    "$@" \
    -vn \
    -af 'asetnsamples=n=4800,astats=metadata=1:reset=1:measure_perchannel=none:measure_overall=RMS_level,ametadata=mode=print:key=lavfi.astats.Overall.RMS_level' \
    -f s16le -ac 2 -ar 48000 - 2>"$viz_dir/meta" \
    | ffplay \
        -hide_banner \
        -nodisp \
        -nostats \
        -autoexit \
        -loglevel error \
        -f s16le -ac 2 -ar 48000 \
        -i - &
  player_pid=$!
else
  # -reconnect_on_network_error needs FFmpeg >= 4.4; ffplay exits on options it
  # does not know, so 4.4 is this script's effective floor.
  ffplay \
    -hide_banner \
    -nodisp \
    -nostats \
    -loglevel warning \
    -reconnect 1 \
    -reconnect_at_eof 1 \
    -reconnect_on_network_error 1 \
    -reconnect_streamed 1 \
    -reconnect_delay_max 5 \
    "$@" &
  player_pid=$!
fi

if [ -n "$np_url" ] && command -v curl >/dev/null 2>&1; then
  np_poll &
  np_pid=$!
fi

# wait returns >128 when a trapped signal interrupts it, so loop until ffplay
# has actually been reaped: radio reports ffplay's real exit status.
st=0
wait "$player_pid" || st=$?
while kill -0 "$player_pid" 2>/dev/null; do
  st=0
  wait "$player_pid" || st=$?
done
exit "$st"
