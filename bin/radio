#!/bin/sh

set -eu

usage() {
  printf '%s\n' 'Usage: radio {sleep|liquid|giants|yacht}' >&2
}

if [ "$#" -ne 1 ]; then
  usage
  exit 2
fi

mode=$1
case "$mode" in
  sleep|liquid|giants|yacht) ;;
  *)
    usage
    exit 2
    ;;
esac

command -v ffplay >/dev/null 2>&1 || {
  printf '%s\n' 'radio: ffplay is missing (install FFmpeg with your package manager)' >&2
  exit 1
}

# Colour and in-place rows only on a terminal: NO_COLOR wins, CLICOLOR_FORCE
# (the BSD/macOS convention ls honours) forces them through a pipe.
pretty=0
if [ -z "${NO_COLOR:-}" ] && { [ -t 1 ] || [ -n "${CLICOLOR_FORCE:-}" ]; }; then
  pretty=1
fi

banner() {          # banner COLOUR <<ART  ->  scene, bold wordmark, dim tag
  if [ "$pretty" -ne 1 ]; then
    cat
    return
  fi
  # The first blank line starts the wordmark; the only bracketed row is the
  # tag. IFS= read -r round-trips leading spaces and backslashes, so the
  # heredocs stay byte-identical to the README.
  printf '\033[38;5;%sm' "$1"
  banner_part=scene
  while IFS= read -r banner_line; do
    case "$banner_part:$banner_line" in
      scene:)
        banner_part=mark
        printf '\033[0m\033[1;38;5;%sm' "$1"
        ;;
      mark:*'[ '*' ]'*)
        banner_part=tag
        printf '\033[0m\033[2;38;5;%sm' "$1"
        ;;
    esac
    printf '%s\n' "$banner_line"
  done
  printf '\033[0m'
}

card() {            # card LABEL [VALUE]  ->  " >> label ....... value"
  card_dots=$((26 - ${#1}))
  if [ -n "${2-}" ] && [ "$card_dots" -gt 0 ]; then
    printf ' >> %s %s %s\n' "$1" "$(printf "%${card_dots}s" '' | tr ' ' '.')" "$2"
  elif [ -n "${2-}" ]; then printf ' >> %s %s\n' "$1" "$2"
  else printf ' >> %s\n' "$1"; fi
}

# Now-playing metadata source for the selected station; empty np_url means the
# station has none (KNBR is talk programming, not tracks).
np_url=''
np_kind=''
np_cookie=''

case "$mode" in
  sleep)
    nitejar_cookie=${NITEJAR_COOKIE:-}
    unset NITEJAR_COOKIE
    case "$nitejar_cookie" in
      ''|*[!0123456789abcdef]*)
        printf '%s\n' 'radio: NITEJAR_COOKIE must be a 64-character lowercase SHA-256 value' >&2
        exit 1
        ;;
    esac
    if [ "${#nitejar_cookie}" -ne 64 ]; then
      printf '%s\n' 'radio: NITEJAR_COOKIE must be a 64-character lowercase SHA-256 value' >&2
      exit 1
    fi

    banner 110 <<'ART'
           *     ,MMM8&&&.            *
                MMMM88&&&&&    .
               MMMM88&&&&&&&
   *           MMM88&&&&&&&&
               MMM88&&&&&&&&
               'MMM88&&&&&&'
                 'MMM8&&&'      *
        |\___/|     /\___/\
        )     (     )    ~( .             '
       =\     /=   =\~    /=
         )===(       ) ~ (
        /     \     /     \
        |     |     ) ~   (
       /       \   /     ~ \
       \       /   \~     ~/
jgs_/\_/\__  _/_/\_/\__~__/_/\_/\_/\_/\_/\_
|  |  |  |( (  |  |  | ))  |  |  |  |  |  |
|  |  |  | ) ) |  |  |//|  |  |  |  |  |  |
|  |  |  |(_(  |  |  (( |  |  |  |  |  |  |
|  |  |  |  |  |  |  |\)|  |  |  |  |  |  |
|  |  |  |  |  |  |  |  |  |  |  |  |  |  |

 _   _ ___ _____ _____      _    _    ____
| \ | |_ _|_   _| ____|    | |  / \  |  _ \
|  \| || |  | | |  _|   _  | | / _ \ | |_) |
| |\  || |  | | | |___ | |_| |/ ___ \|  _ <
|_| \_|___| |_| |_____| \___//_/   \_\_| \_\
                 [ A M B I E N T ]

ART
    station='Nitejar'
    # ffplay wants the header CRLF-terminated: $(printf '\r') keeps the CR and the
    # quoted line break supplies the LF. The cookie is validated above so it
    # cannot inject another header.
    header="Cookie: nj_awake=$nitejar_cookie$(printf '\r')
"
    set -- -headers "$header" -i 'https://nitejar.net/stream/nightjar.opus'
    # The title lives on the MP3 mount in status-json (the Opus mount carries
    # none), exactly as the Nitejar web player reads it. Same gate cookie.
    np_url='https://nitejar.net/stream/status-json.xsl'
    np_kind='icecast'
    np_cookie="nj_awake=$nitejar_cookie"
    ;;

  liquid)
    banner 45 <<'ART'
                    .
                   / \
                  /   \
                 /     \
                /       \
               |         |
                \       /
                 '.___.'
             _.-'     '-._
       _..--'             '--.._
 ~~~~~~      ~~~~   ~~~~       ~~~~~~

 _     ___  ___  _   _ ___ ____
| |   |_ _|/ _ \| | | |_ _|  _ \
| |    | || | | | | | || || | | |
| |___ | || |_| | |_| || || |_| |
|_____|___|\__\_\\___/|___|____/
          [ J A Z Z Y  D R U M  &  B A S S ]

ART
    station='Liquid DnB'
    set -- -i 'https://antares.dribbcast.com/proxy/dave1/stream/;'
    # Shoutcast v2 serves the current song as one line of plain text.
    np_url='https://antares.dribbcast.com/proxy/dave1/currentsong?sid=1'
    np_kind='text'
    ;;

  giants)
    banner 208 <<'ART'
                 .-""""""""-.
              .-'            '-.
            .'   /`-.      .-'\   '.
           /    /-/          \-\    \
          ;    /-/            \-\    ;
          |   /-/              \-\   |
          |  ( (       SF       ) )  |
          |   \-\              /-/   |
          ;    \-\            /-/    ;
           \    \-\          /-/    /
            '.   \`-.      .-'/   .'
              '-.            .-'
                 '-.______.-'

  ____ ___    _    _   _ _____ ____
 / ___|_ _|  / \  | \ | |_   _/ ___|
| |  _ | |  / _ \ |  \| | | | \___ \
| |_| || | / ___ \| |\  | | |  ___) |
 \____|___/_/   \_\_| \_| |_| |____/
             [ S A N  F R A N C I S C O ]

ART
    station='KNBR 104.5 FM / 680 AM'
    set -- -i 'https://playerservices.streamtheworld.com/api/livestream-redirect/KNBRAMAAC.aac'
    ;;

  yacht)
    banner 216 <<'ART'
          \ | /               .
        -- ( ) --            /|\
          / | \             / | \
                           /  |  \
                          /   |   \
                         /    |    \
                        /     |     \
                       /______|______\
                 _____________|_____________
                 \                         /
            ~~~~~~\_______________________/~~~~~~
          ~~~   ~~~~~     ~~~~   ~~~~~     ~~~~

__   __ _    ____ _   _ _____
\ \ / // \  / ___| | | |_   _|
 \ V // _ \| |   | |_| | | |
  | |/ ___ \ |___|  _  | | |
  |_/_/   \_\____|_| |_| |_|
 [ S M O O T H  S A I L I N G ]

ART
    station='56 Yacht Rock Radio'
    set -- -i 'https://cast4.my-control-panel.com/proxy/clearco1/stream'
    # Centova Cast proxy in front of Shoutcast v2: currentsong is one line of
    # plain text. The station pads its tags with runs of spaces; np_title
    # squeezes them.
    np_url='https://cast4.my-control-panel.com/proxy/clearco1/currentsong?sid=1'
    np_kind='text'
    ;;

esac

# Now playing: a background poller fetches the station's status endpoint and
# prints the track title when it changes. Status endpoints, never a second
# audio connection -- a poll costs bytes, not a listener slot. curl is a soft
# dependency: without it the station plays exactly as before, just untitled.

np_fetch() {
  # curl -m bounds time, not bytes; dd caps a hostile endpoint at 8 KiB per
  # poll so neither the shell variable holding the title nor sed's line buffer
  # can be grown without bound.
  if [ -n "$np_cookie" ]; then
    curl -fs -m 10 -H "Cookie: $np_cookie" "$np_url"
  else
    curl -fs -m 10 "$np_url"
  fi | dd bs=1 count=8192 2>/dev/null
}

np_title() {
  # The tr is an ASCII whitelist, not a control-byte blocklist: C0 controls,
  # DEL, UTF-8-encoded C1 controls (8-bit CSI/OSC), and bidi overrides must
  # all die before a station-controlled title reaches the terminal, and a
  # blocklist misses the multi-byte forms. LC_ALL=C keeps sed and tr
  # byte-oriented (BSD builds abort on bytes invalid in a UTF-8 locale);
  # cut bounds the printed line and is safe here because the whitelist has
  # already reduced the stream to single-byte characters. tr -s collapses
  # the runs of spaces some stations pad their tags with.
  case "$np_kind" in
    icecast)
      np_fetch | LC_ALL=C sed -n 's/.*"listenurl":"[^"]*nightjar\.mp3"[^}]*"title":"\([^"]*\)".*/\1/p'
      ;;
    *)
      np_fetch
      ;;
  esac | LC_ALL=C tr -cd ' -~' | LC_ALL=C tr -s ' ' | cut -c 1-200
}

# The now-playing row's leader, as card 'now playing' prints it (32 columns).
np_lead=' >> now playing ............... '

np_width() {
  # Title columns left on the row: COLUMNS if numeric, else tput cols (a soft
  # dependency; prints 80 without a terminal), else 80. Anything narrower
  # than 40 is a bogus size, not a terminal, so it also falls back to 80.
  np_w=${COLUMNS:-}
  case "$np_w" in
    ''|*[!0123456789]*) np_w=$(tput cols 2>/dev/null || :) ;;
  esac
  case "$np_w" in
    ''|*[!0123456789]*) np_w=80 ;;
  esac
  if [ "$np_w" -lt 40 ]; then
    np_w=80
  fi
  printf '%s\n' $((np_w - ${#np_lead}))
}

np_poll() {
  np_last=''
  # On a terminal the row appears at once as a placeholder and is repainted
  # in place on every poll, cut to the terminal width so it never wraps (a
  # wrapped line cannot be overwritten; the repaint also heals a row broken
  # by an ffplay warning). Through a pipe rows append only when the title
  # changes, so radio liquid | grep keeps working.
  if [ "$pretty" -eq 1 ]; then
    printf '%s' "$np_lead"
  fi
  while :; do
    np_now=$(np_title 2>/dev/null || true)
    kill -0 "$$" 2>/dev/null || exit 0
    if [ "$pretty" -eq 1 ]; then
      if [ -n "$np_now" ]; then
        printf '\r\033[2K%s%s' "$np_lead" "$(printf '%s' "$np_now" | cut -c 1-"$(np_width)")"
      else
        printf '\r\033[2K%s' "$np_lead"
      fi
    elif [ -n "$np_now" ] && [ "$np_now" != "$np_last" ]; then
      np_last=$np_now
      card 'now playing' "$np_now"
    fi
    # Sleep in 1-second slices: kill -9 of the script skips every trap, and
    # this bounds how long an orphaned poller can outlive its parent.
    np_t=0
    while [ "$np_t" -lt 15 ]; do
      sleep 1
      kill -0 "$$" 2>/dev/null || exit 0
      np_t=$((np_t + 1))
    done
  done
}

card station "$station"
card Ctrl-C silence

# ffplay used to be exec'd. It now runs as a background child under wait, for
# two reasons: the EXIT trap must reap the poller, and a trapped signal is
# deferred for as long as the shell waits on a FOREGROUND child -- kill on the
# script's PID would neither stop playback nor run any trap. POSIX guarantees
# that wait returns the moment a trapped signal arrives, so INT/TERM forward
# to ffplay immediately and its exit status becomes this script's, as it was
# under exec. (Backgrounding does not detach ffplay from the terminal's
# process group, so plain Ctrl-C still reaches it directly as well.)
np_pid=''
player_pid=''

np_stop() {
  # Capturing $? stops the trap from laundering the exit status: mksh would
  # otherwise report the EXIT trap's own status (0) after Ctrl-C.
  st=$?
  if [ -n "$np_pid" ]; then
    kill "$np_pid" 2>/dev/null || true
  fi
  # The in-place row has no newline of its own: land the prompt on a fresh one.
  if [ "$pretty" -eq 1 ] && [ -n "$np_pid" ]; then
    printf '\n'
  fi
  return "$st"
}

forward() {
  if [ -n "$player_pid" ]; then
    kill -s "$1" "$player_pid" 2>/dev/null || true
  else
    exit "$2"
  fi
}

trap np_stop EXIT
trap 'forward INT 130' INT
trap 'forward TERM 143' TERM

# -reconnect_on_network_error needs FFmpeg >= 4.4; ffplay exits on options it
# does not know, so 4.4 is this script's effective floor.
ffplay \
  -hide_banner \
  -nodisp \
  -nostats \
  -loglevel warning \
  -reconnect 1 \
  -reconnect_at_eof 1 \
  -reconnect_on_network_error 1 \
  -reconnect_streamed 1 \
  -reconnect_delay_max 5 \
  "$@" &
player_pid=$!

if [ -n "$np_url" ] && command -v curl >/dev/null 2>&1; then
  np_poll &
  np_pid=$!
fi

# wait returns >128 when a trapped signal interrupts it, so loop until ffplay
# has actually been reaped: radio reports ffplay's real exit status.
st=0
wait "$player_pid" || st=$?
while kill -0 "$player_pid" 2>/dev/null; do
  st=0
  wait "$player_pid" || st=$?
done
exit "$st"
